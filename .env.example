# Copy this file to .env before running Docker Compose.
POSTGRES_DB=repolens
POSTGRES_USER=repolens
POSTGRES_PASSWORD=change-me-for-non-local-use
REPOLENS_DATABASE_URL=postgresql+psycopg://repolens:change-me-for-non-local-use@postgres:5432/repolens
REPOLENS_CORS_ORIGINS=http://localhost:5173
REPOLENS_INGESTION_INCLUDE_GLOBS=*.py
REPOLENS_INGESTION_EXCLUDE_GLOBS=
REPOLENS_INGESTION_EXCLUDE_DIRECTORIES=.git,.hg,.svn,.venv,venv,node_modules,__pycache__,build,dist,.tox,.nox
REPOLENS_INGESTION_MAX_FILES=2500
REPOLENS_INGESTION_MAX_TOTAL_BYTES=25000000
REPOLENS_INGESTION_MAX_FILE_BYTES=1000000
REPOLENS_INGESTION_MAX_CLONE_BYTES=250000000
REPOLENS_INGESTION_CLONE_TIMEOUT_SECONDS=120
REPOLENS_QDRANT_URL=http://qdrant:6333
REPOLENS_QDRANT_COLLECTION=repolens_code_units
REPOLENS_EMBEDDING_PROVIDER=hashing
REPOLENS_EMBEDDING_DIMENSIONS=384
REPOLENS_RETRIEVAL_MAX_UNIT_CHARS=12000
REPOLENS_RETRIEVAL_MAX_UNITS_PER_SNAPSHOT=20000
REPOLENS_RETRIEVAL_LEXICAL_CANDIDATE_LIMIT=5000
REPOLENS_RETRIEVAL_HYBRID_RRF_K=60
REPOLENS_GRAPH_SOURCE_ROOTS=src
REPOLENS_LLM_PROVIDER=gemini
REPOLENS_LLM_MODEL=gemini-3.5-flash-lite
REPOLENS_LLM_FALLBACK_PROVIDER=groq
REPOLENS_LLM_FALLBACK_MODEL=openai/gpt-oss-20b
REPOLENS_LLM_TIMEOUT_SECONDS=90
REPOLENS_GEMINI_API_KEY=
REPOLENS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
REPOLENS_GROQ_API_KEY=
REPOLENS_GROQ_BASE_URL=https://api.groq.com/openai/v1
REPOLENS_OPENROUTER_API_KEY=
REPOLENS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
REPOLENS_OPENROUTER_SITE_URL=
REPOLENS_OLLAMA_URL=http://host.docker.internal:11434
REPOLENS_AGENT_MAX_STEPS=4
REPOLENS_AGENT_MAX_TOOL_CALLS_PER_STEP=4
REPOLENS_AGENT_MAX_EVIDENCE_ITEMS=30
REPOLENS_AGENT_MAX_SOURCE_LINES=400
REPOLENS_AGENT_EVALUATION_MAX_EVIDENCE_CHARS=16000
REPOLENS_DEPENDENCY_MAX_MANIFESTS=100
REPOLENS_DEPENDENCY_MAX_RECORDS=5000
REPOLENS_OSV_API_URL=https://api.osv.dev
REPOLENS_OSV_TIMEOUT_SECONDS=20
REPOLENS_OSV_MAX_RESULTS_PER_DEPENDENCY=100
VITE_API_BASE_URL=http://localhost:8000/api/v1
