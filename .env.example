# Copy this file to .env before running Docker Compose.
POSTGRES_DB=repolens
POSTGRES_USER=repolens
POSTGRES_PASSWORD=change-me-for-non-local-use
REPOLENS_DATABASE_URL=postgresql+psycopg://repolens:change-me-for-non-local-use@postgres:5432/repolens
REPOLENS_CORS_ORIGINS=http://localhost:5173
REPOLENS_INGESTION_INCLUDE_GLOBS=*.py
REPOLENS_INGESTION_EXCLUDE_GLOBS=
REPOLENS_INGESTION_EXCLUDE_DIRECTORIES=.git,.hg,.svn,.venv,venv,node_modules,__pycache__,build,dist,.tox,.nox
REPOLENS_INGESTION_MAX_FILES=2500
REPOLENS_INGESTION_MAX_TOTAL_BYTES=25000000
REPOLENS_INGESTION_MAX_FILE_BYTES=1000000
REPOLENS_INGESTION_MAX_CLONE_BYTES=250000000
REPOLENS_INGESTION_CLONE_TIMEOUT_SECONDS=120
REPOLENS_QDRANT_URL=http://qdrant:6333
REPOLENS_QDRANT_COLLECTION=repolens_code_units
REPOLENS_EMBEDDING_PROVIDER=hashing
REPOLENS_EMBEDDING_DIMENSIONS=384
REPOLENS_RETRIEVAL_MAX_UNIT_CHARS=12000
REPOLENS_RETRIEVAL_MAX_UNITS_PER_SNAPSHOT=20000
REPOLENS_RETRIEVAL_LEXICAL_CANDIDATE_LIMIT=5000
REPOLENS_RETRIEVAL_HYBRID_RRF_K=60
VITE_API_BASE_URL=http://localhost:8000/api/v1
