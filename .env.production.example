# Copy to .env.production, replace every placeholder, and protect the file as a secret.
POSTGRES_DB=repolens
POSTGRES_USER=repolens
POSTGRES_PASSWORD=replace-with-a-long-random-password
REPOLENS_DATABASE_URL=postgresql+psycopg://repolens:replace-with-a-long-random-password@postgres:5432/repolens
REPOLENS_CORS_ORIGINS=https://repolens.example.com
REPOLENS_ALLOWED_HOSTS=repolens.example.com
REPOLENS_PUBLIC_PORT=8080
REPOLENS_LLM_PROVIDER=gemini
REPOLENS_LLM_MODEL=gemini-3.5-flash-lite
REPOLENS_LLM_FALLBACK_PROVIDER=
REPOLENS_LLM_FALLBACK_MODEL=
REPOLENS_GEMINI_API_KEY=
REPOLENS_GROQ_API_KEY=
REPOLENS_OPENROUTER_API_KEY=
REPOLENS_INGESTION_MAX_CONCURRENT_JOBS=2
REPOLENS_INGESTION_MAX_QUEUED_JOBS=100
